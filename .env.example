# Copy to .env and fill in. Never commit real keys.

# Backend: mock (offline, no keys) | openai (any OpenAI-compatible /chat/completions API) | anthropic
ROUTER_BACKEND=mock

# Model pair (defaults come from configs/default.yaml)
# CHEAP_MODEL=gpt-3.5-turbo-1106
# STRONG_MODEL=gpt-4-1106-preview

# Base URLs. Defaults: https://api.openai.com/v1 (openai) or https://api.anthropic.com (anthropic).
# For Gemini's OpenAI-compatible endpoint, Groq, Together, vLLM or Ollama set these, e.g.
# CHEAP_BASE_URL=http://localhost:11434/v1
# STRONG_BASE_URL=https://api.openai.com/v1

# API keys (required when ROUTER_BACKEND is openai or anthropic).
# CHEAP_API_KEY / STRONG_API_KEY fall back to OPENAI_API_KEY or ANTHROPIC_API_KEY.
CHEAP_API_KEY=
STRONG_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Prices, USD per 1M tokens (override the table in configs/default.yaml; unknown models cost 0)
# CHEAP_PRICE_IN=1.0
# CHEAP_PRICE_OUT=2.0
# STRONG_PRICE_IN=10.0
# STRONG_PRICE_OUT=30.0

# Router artifact stem (without .npz/.json) and decision policy
# ROUTER_ARTIFACT=artifacts/router_lr
# ROUTER_POLICY=threshold            # threshold | budget
# ROUTER_THRESHOLD=                  # unset -> artifact's rel95 threshold
# ROUTER_BUDGET_FRAC=0.3             # target strong share for the budget policy
# ROUTER_EMBEDDER=                   # override the artifact's embedder name (mainly tests; e.g. hashing)

# SQLite request log (the dashboard reads the same file)
# ROUTER_DB=data/requests.sqlite
